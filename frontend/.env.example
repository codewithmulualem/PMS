# Dev default: relative "/api" runs same-origin through the Vite proxy
# (vite.config.js -> http://127.0.0.1:5001). For a statically hosted build,
# set an absolute URL instead, e.g.:
# VITE_API_BASE_URL=http://127.0.0.1:5001/api
VITE_API_BASE_URL=/api
# Optional local-only convenience for seeded demo accounts. Do not set in production.
# VITE_DEMO_PASSWORD=the-password-printed-by-seed.py
